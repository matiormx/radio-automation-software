{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiRadio",
  "version": "0.5.3",
  "identifier": "com.miradio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "MiRadio — Estudio de automatización",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQ0QxQkNBNDNBNjY2RTMKUldUalpxWkR5aHZOY2ZGV2R0WlBvYVBsZ2VzOHgxOERRY3NLekF6d1dSaW9VWDREQ1YxOWdPTjAK",
      "endpoints": [
        "https://github.com/matiormx/radio-automation-software/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
